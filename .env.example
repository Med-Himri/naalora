# Public site URL (used for canonical links, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://naalora.com

# MongoDB Atlas — leave MONGODB_URI empty to run in demo mode (in-memory data)
MONGODB_URI=
MONGODB_DB=naalora

# Cloudinary (server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin password for /admin (server only). Dev fallback: "admin". Required in production.
ADMIN_PASSWORD=

# Public contact info
NEXT_PUBLIC_WHATSAPP_NUMBER=212600000000
NEXT_PUBLIC_CONTACT_EMAIL=contact@naalora.com
